{
  "compilerOptions": {
    "target": "es2015",
    "moduleResolution": "node10",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "isolatedDeclarations": true
  },
  "exclude": ["node_modules"]
}
