{
  "compilerOptions": {
    "target": "es2015",
    "moduleResolution": "node10",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../dist"
  },
  "exclude": ["node_modules", "dist"]
}
