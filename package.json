{
  "name": "wsz-tools",
  "version": "1.0.0",
  "author": "wsz",
  "license": "MIT",
  "keywords": [
    "tools"
  ],
  "description": "A collection of tools for daily development tasks.",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    "./framework/vue2": {
      "import": "./dist/framework/vue/v2/index.js"
    },
    "./script/browser": {
      "import": "./dist/script/browser/index.js",
      "types": "./dist/types/script/browser/index.d.ts"
    },
    "./script/mp": {
      "import": "./dist/script/mp/index.js",
      "types": "./dist/types/script/mp/index.d.ts"
    },
    "./script/node": {
      "require": "./dist/script/node/index.js",
      "types": "./dist/types/script/node/index.d.ts"
    },
    "./script/common": {
      "import": "./dist/script/common/index.js",
      "types": "./dist/types/script/common/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "workspaces": [
    "packages/framework/vue/v2",
    "packages/script/browser",
    "packages/script/mp",
    "packages/script/node",
    "packages/script/common"
  ],
  "scripts": {
    "init": "npm install && cd ./test && npm install",
    "postinit": "npm run link",
    "prepare": "tsx ./scripts/npm-prepare.ts",
    "dev": "npm-run-all --parallel --continue-on-error dev:build test:browser",
    "dev:build": "dotenvx run -f .env.development -- rolldown -c ./rolldown.config.ts --watch",
    "server": "live-server ./test --port=3636 --host=127.0.0.1 --open",
    "prebuild": "rimraf ./dist",
    "build": "dotenvx run -f .env.production -- rolldown -c ./rolldown.config.ts && npm run rollup",
    "link": "tsx ./scripts/package-link.ts",
    "test:browser": "cd ./test && npm run dev",
    "test:mp": "cd ./test/script/mp/v2 && npm run serve",
    "cz": "npx lint-staged -c ./.lintstagedrc.cjs && cz",
    "rollup": "rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript --watch"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.15",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.3",
    "commitizen": "^4.2.6",
    "commitlint": "^18.6.1",
    "commitlint-config-cz": "^0.13.3",
    "cz-customizable": "^7.4.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "husky": "^9.1.7",
    "less": "^4.3.0",
    "lint-staged": "^15.5.2",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "postcss-html": "^1.8.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "rolldown": "^1.0.0-beta.27",
    "rolldown-plugin-dts": "^0.13.14",
    "rollup": "^4.45.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-vue": "^5.1.9",
    "stylelint": "^16.19.1",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "tslib": "^2.8.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vue-template-compiler": "^2.6.14"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.44.2",
    "ansi-colors": "^4.1.3",
    "lodash-es": "^4.17.21"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./cz-config.cjs"
    }
  }
}
